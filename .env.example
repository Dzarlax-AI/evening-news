# Local Compose template only. Replace every placeholder before starting services.
# Database passwords must match the corresponding DSNs below. URL-encode special
# characters in DSN passwords before using them in connection URLs.
DB_PASSWORD=replace-with-local-db-password
SCHEDULER_DB_PASSWORD=replace-with-local-scheduler-db-password

# Keep web and executor DSNs separate even when local development uses the same
# database role. Production can then preserve each role's effective DSN exactly.
WEB_DATABASE_URL=postgresql://newsuser:replace-with-local-db-password@postgres:5432/newsdb
EXECUTOR_DATABASE_URL=postgresql+asyncpg://newsuser:replace-with-local-db-password@postgres:5432/newsdb
SCHEDULER_DATABASE_URL=postgres://scheduler:replace-with-local-scheduler-db-password@scheduler-postgres:5432/schedulerdb

# The background components use separately provisioned local roles.
WORKER_DATABASE_URL=postgres://worker:replace-with-worker-password@postgres:5432/newsdb
INGESTION_DATABASE_URL=postgres://ingestion:replace-with-ingestion-password@postgres:5432/newsdb
PROCESSING_DATABASE_URL=postgres://processing:replace-with-processing-password@postgres:5432/newsdb

GEMINI_API_KEY=replace-with-your-gemini-api-key
TELEGRAM_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-your-telegram-chat-id
ADMIN_PASSWORD=replace-with-a-local-admin-password
JWT_SECRET=replace-with-a-long-random-jwt-secret
WEB_BACKEND_TOKEN=replace-with-random-web-executor-token

# Use distinct random values for each private service boundary.
ARTICLE_PROCESSING_TOKEN=replace-with-random-processing-token
ARTICLE_AI_TOKEN=replace-with-a-separate-random-ai-callback-token
ARTICLE_INGESTION_TOKEN=replace-with-random-ingestion-token
EXTRACTION_SERVICE_TOKEN=replace-with-random-extractor-token
JOB_EXECUTOR_TOKEN=replace-with-random-executor-token
SCHEDULER_API_TOKEN=replace-with-random-scheduler-api-token
SCHEDULED_JOBS_TOKEN=replace-with-random-scheduled-jobs-token
