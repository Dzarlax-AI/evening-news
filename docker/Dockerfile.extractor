FROM golang:1.26.10-bookworm@sha256:386f0cbb8fb3402ff5a15048c96731e6ff37142d31182f3b72306359a1f5e9b7 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY . .
ARG BUILD_VERSION=development
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.buildVersion=${BUILD_VERSION}" -o /extract-service ./cmd/extract-service \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /extract-egress ./cmd/extract-egress

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /extract-service /extract-service
COPY --from=build /extract-egress /extract-egress
USER 65532:65532
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 CMD ["/extract-service", "-healthcheck"]
ENTRYPOINT ["/extract-service"]
