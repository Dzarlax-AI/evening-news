# Copy to scheduler.env and set mode 0600. Do not put credentials in Compose
# YAML, the existing News .env, shell history, logs, or artifacts.
SCHEDULER_DATABASE_URL=postgres://scheduler_runtime:URL_ENCODED_PASSWORD@infra-postgres-1:5432/evening_news_scheduler
SCHEDULER_DB_SCHEMA=scheduler_service
SCHEDULER_API_TOKEN=REPLACE_WITH_RANDOM_API_TOKEN
SCHEDULER_TARGET_ALIASES=news-worker
SCHEDULER_TARGET_NEWS_WORKER_URL=http://app:8000/api/v1/internal/scheduled-jobs
SCHEDULER_TARGET_NEWS_WORKER_TOKEN=REPLACE_WITH_RANDOM_RECEIVER_TOKEN
