# Copy to scheduler-client.env and set mode 0600. Use the same API and
# receiver token values as scheduler.env. These are separate credentials with
# separate scopes; never reuse the News administrator or database credential.
SCHEDULER_API_TOKEN=REPLACE_WITH_RANDOM_API_TOKEN
SCHEDULED_JOBS_TOKEN=REPLACE_WITH_RANDOM_RECEIVER_TOKEN
# Preserve the deployed host allowlist and include the app's internal Compose
# hostname so scheduler-to-app requests pass host validation. Add any existing
# custom hosts; never use a wildcard.
TRUSTED_HOSTS=news.dzarlax.dev,localhost,127.0.0.1,app
