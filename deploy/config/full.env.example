# NEWS_SCHEDULER_DIR | string | default: Compose: required
# NEWS_SCHEDULER_DIR=
# NEWS_WORKER_IP | string | default: Compose: required
# NEWS_WORKER_IP=
# OPENAI_API_KEY | secret string | default: empty / unset
# OPENAI_API_KEY=
