# NEWS_PROCESSING_NETWORK=
# NEWS_PROXY_IP | string | default: Compose: required
# NEWS_PROXY_IP=
# NEWS_PROXY_TOKEN | secret string | default: Compose: required
# NEWS_PROXY_TOKEN=
# NEWS_RUNTIME_FILE | string | default: unset selects legacy; domain and background reject explicitly empty value; web/extractor/egress select legacy for empty value
