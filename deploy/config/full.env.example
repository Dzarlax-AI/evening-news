# NEWS_NATIVE_CHROME_ENDPOINT | URL | default: Compose: required
# NEWS_NATIVE_CHROME_ENDPOINT=
# NEWS_NATIVE_NETWORK_ISOLATION_ASSERTION | string | default: Compose: required
# NEWS_NATIVE_NETWORK_ISOLATION_ASSERTION=
