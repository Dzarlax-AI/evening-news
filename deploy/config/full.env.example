# Complete advanced environment-name inventory for generators and operators.
# Every assignment is commented. Values below are metadata placeholders, not
# recommendations or secrets. Do not enable every option in one deployment.
# Test/fixture and operator/CI-only switches are excluded intentionally; they
# are not installation settings. See docs/configuration.md and catalog.json.
# Managed role-file values are private per-role data, not entries for .env.

# ADMIN_PASSWORD | secret string | default: empty; required in legacy web
# ADMIN_PASSWORD=
# ADMIN_USERNAME | string | default: admin
# ADMIN_USERNAME=
# AI_CACHED_INPUT_COST_PER_1M | string | default: 0 if absent/invalid
# AI_CACHED_INPUT_COST_PER_1M=
# AI_INPUT_COST_PER_1M | string | default: 0 if absent/invalid
# AI_INPUT_COST_PER_1M=
# AI_MODEL_PRICES | JSON | default: empty; model prices unknown
# AI_MODEL_PRICES=
# AI_OUTPUT_COST_PER_1M | string | default: 0 if absent/invalid
# AI_OUTPUT_COST_PER_1M=
# AI_PROVIDER | string | default: gemini
# AI_PROVIDER=
# ALLOWED_ORIGINS | comma-separated list | default: web: http://localhost:8000,http://127.0.0.1:8000,https://news.dzarlax.dev; example Compose: http://localhost:8000
# ALLOWED_ORIGINS=
# ALLOW_CREATE_ALL | boolean | default: true
# ALLOW_CREATE_ALL=
# ARTICLE_AI_TOKEN | secret string | default: empty; required by consumer
# ARTICLE_AI_TOKEN=
# ARTICLE_AI_URL | URL | default: empty; required by consumer
# ARTICLE_AI_URL=
# ARTICLE_INGESTION_DATABASE_URL | PostgreSQL URL (contains credentials) | default: Compose: required
# ARTICLE_INGESTION_DATABASE_URL=
# ARTICLE_INGESTION_DB_MAX_CONNS | number | default: 5
# ARTICLE_INGESTION_DB_MAX_CONNS=
# ARTICLE_INGESTION_IMAGE | string | default: Compose: required
# ARTICLE_INGESTION_IMAGE=
# ARTICLE_INGESTION_LISTEN | string | default: :8093
# ARTICLE_INGESTION_LISTEN=
# ARTICLE_INGESTION_TOKEN | secret string | default: empty; required by consumer
# ARTICLE_INGESTION_TOKEN=
# ARTICLE_PROCESSING_DATABASE_URL | PostgreSQL URL (contains credentials) | default: Compose: required
# ARTICLE_PROCESSING_DATABASE_URL=
# ARTICLE_PROCESSING_DB_MAX_CONNS | number | default: 5
# ARTICLE_PROCESSING_DB_MAX_CONNS=
# ARTICLE_PROCESSING_IMAGE | string | default: Compose: required
# ARTICLE_PROCESSING_IMAGE=
# ARTICLE_PROCESSING_LISTEN | string | default: :8094
# ARTICLE_PROCESSING_LISTEN=
# ARTICLE_PROCESSING_TOKEN | secret string | default: empty; required by consumer
# ARTICLE_PROCESSING_TOKEN=
# BACKGROUND_EXECUTION_MODE | string | default: web: worker; domain treats any value except embedded as worker
# BACKGROUND_EXECUTION_MODE=
# BACKGROUND_HEALTH_LISTEN | string | default: :8095
# BACKGROUND_HEALTH_LISTEN=
# BACKGROUND_SHUTDOWN_TIMEOUT_SECONDS | number | default: 60 seconds
# BACKGROUND_SHUTDOWN_TIMEOUT_SECONDS=
# BACKGROUND_WORKER_BACKOFF_MAX | Go duration | default: 5s
# BACKGROUND_WORKER_BACKOFF_MAX=
# BACKGROUND_WORKER_BACKOFF_MIN | Go duration | default: 250ms
# BACKGROUND_WORKER_BACKOFF_MIN=
# CATEGORIZATION_MODEL | string | default: Compose: default 'gemini-3.5-flash-lite'
# CATEGORIZATION_MODEL=
# CHROME_ENDPOINT | URL | default: empty / unset
# CHROME_ENDPOINT=
# CHROME_HEALTHCHECK_FD_THRESHOLD | number | default: 800
# CHROME_HEALTHCHECK_FD_THRESHOLD=
# CLOAK_CONTROLLER_IPS | JSON | default: empty; wrapper validates controllers
# CLOAK_CONTROLLER_IPS=
# CLOAK_PROXY_IP | string | default: empty / unset
# CLOAK_PROXY_IP=
# CLOAK_SELF_IP | string | default: empty / unset
# CLOAK_SELF_IP=
# DATABASE_URL | PostgreSQL URL (contains credentials) | default: empty; required by consumer
# DATABASE_URL=
# DB_MAX_OVERFLOW | number | default: 10
# DB_MAX_OVERFLOW=
# DB_PASSWORD | secret string | default: Compose: required
# DB_PASSWORD=
# DB_POOL_SIZE | number | default: 5
# DB_POOL_SIZE=
# DEVELOPMENT | boolean | default: false
# DEVELOPMENT=
# DIGEST_MODEL | string | default: domain: gemini-3.5-flash-lite; legacy RPC: empty
# DIGEST_MODEL=
# DOMAIN_SERVICE_URL | URL | default: http://executor:8100
# DOMAIN_SERVICE_URL=
# EGRESS_ALLOW_WILDCARD_BIND | boolean | default: false
# EGRESS_ALLOW_WILDCARD_BIND=
# EGRESS_LISTEN_ADDR | string | default: 127.0.0.1:8081
# EGRESS_LISTEN_ADDR=
# EGRESS_MAX_CONCURRENT | number | default: 32
# EGRESS_MAX_CONCURRENT=
# EGRESS_MAX_LIFETIME_SECONDS | number | default: 35 seconds
# EGRESS_MAX_LIFETIME_SECONDS=
# EGRESS_MAX_TUNNEL_BYTES | number | default: 33554432 bytes
# EGRESS_MAX_TUNNEL_BYTES=
# EGRESS_TOKEN | secret string | default: empty; required (16–256 bytes)
# EGRESS_TOKEN=
# EXECUTION_DATABASE_URL | PostgreSQL URL (contains credentials) | default: empty; required by consumer
# EXECUTION_DATABASE_URL=
# EXECUTION_DB_SCHEMA | string | default: empty / unset
# EXECUTION_DB_SCHEMA=
# EXECUTION_MAX_CONNECTIONS | number | default: 2
# EXECUTION_MAX_CONNECTIONS=
# EXECUTION_SERVICE_URL | URL | default: http://background:8101
# EXECUTION_SERVICE_URL=
# EXECUTOR_DATABASE_URL | PostgreSQL URL (contains credentials) | default: Compose: required
# EXECUTOR_DATABASE_URL=
# EXTRACTION_BROWSER_MAX_BYTES | number | default: 5242880 bytes
# EXTRACTION_BROWSER_MAX_BYTES=
# EXTRACTION_HTTP_MAX_BYTES | number | default: 5242880 bytes
# EXTRACTION_HTTP_MAX_BYTES=
# EXTRACTION_SERVICE_NATIVE_BROWSER | boolean | default: false
# EXTRACTION_SERVICE_NATIVE_BROWSER=
# EXTRACTION_SERVICE_TIMEOUT_SECONDS | number | default: 30 seconds
# EXTRACTION_SERVICE_TIMEOUT_SECONDS=
# EXTRACTION_SERVICE_TOKEN | secret string | default: empty; required by consumer
# EXTRACTION_SERVICE_TOKEN=
# EXTRACTION_SERVICE_TOTAL_BUDGET_SECONDS | number | default: 120 seconds
# EXTRACTION_SERVICE_TOTAL_BUDGET_SECONDS=
# EXTRACTION_SERVICE_URL | URL | default: empty; required by consumer
# EXTRACTION_SERVICE_URL=
# EXTRACTION_TEXT_MAX_CHARS | number | default: 100000 characters
# EXTRACTION_TEXT_MAX_CHARS=
# EXTRACTOR_BROWSER_BACKEND | string | default: empty / unset
# EXTRACTOR_BROWSER_BACKEND=
# EXTRACTOR_BROWSER_CONCURRENT | number | default: standalone: 1; example Compose: 2
# EXTRACTOR_BROWSER_CONCURRENT=
# EXTRACTOR_HTTP_ONLY | boolean | default: true
# EXTRACTOR_HTTP_ONLY=
# EXTRACTOR_MAX_CONCURRENT | number | default: standalone: 5; example Compose: 4
# EXTRACTOR_MAX_CONCURRENT=
# EXTRACTOR_NATIVE_DIAGNOSTICS | string | default: empty / unset
# EXTRACTOR_NATIVE_DIAGNOSTICS=
# EXTRACTOR_NATIVE_NETWORK_ISOLATED | boolean | default: empty / unset
# EXTRACTOR_NATIVE_NETWORK_ISOLATED=
# EXTRACTOR_NATIVE_PROXY_TOKEN | secret string | default: empty / unset
# EXTRACTOR_NATIVE_PROXY_TOKEN=
# EXTRACTOR_NATIVE_PROXY_URL | URL | default: empty / unset
# EXTRACTOR_NATIVE_PROXY_URL=
# EXTRACTOR_NATIVE_READY_SELECTOR | string | default: empty / unset
# EXTRACTOR_NATIVE_READY_SELECTOR=
# EXTRACTOR_SERVICE_TOKEN | secret string | default: empty; required by consumer
# EXTRACTOR_SERVICE_TOKEN=
# GEMINI_API_ENDPOINT | URL | default: domain: https://generativelanguage.googleapis.com/v1/models; legacy RPC: empty
# GEMINI_API_ENDPOINT=
# GEMINI_API_KEY | secret string | default: empty / unset
# GEMINI_API_KEY=
# GEMINI_ENDPOINT | URL | default: standalone editorial: https://generativelanguage.googleapis.com/v1beta/models/<model>:generateContent
# GEMINI_ENDPOINT=
# GEMINI_MODEL | string | default: empty / unset
# GEMINI_MODEL=
# INGESTION_DATABASE_URL | PostgreSQL URL (contains credentials) | default: empty; required by consumer
# INGESTION_DATABASE_URL=
# JOB_EXECUTOR_HOST | string | default: 0.0.0.0
# JOB_EXECUTOR_HOST=
# JOB_EXECUTOR_LISTEN | string | default: :8101
# JOB_EXECUTOR_LISTEN=
# JOB_EXECUTOR_PORT | number | default: 8100
# JOB_EXECUTOR_PORT=
# JOB_EXECUTOR_REQUEST_TIMEOUT_SECONDS | number | default: 5 seconds
# JOB_EXECUTOR_REQUEST_TIMEOUT_SECONDS=
# JOB_EXECUTOR_TOKEN | secret string | default: empty; required by consumer
# JOB_EXECUTOR_TOKEN=
# JOB_EXECUTOR_URL | URL | default: worker: required; ingestion selector fallback: http://127.0.0.1:8100
# JOB_EXECUTOR_URL=
# JWT_SECRET | secret string | default: empty; legacy web falls back to ADMIN_PASSWORD; managed web requires an independent key
# JWT_SECRET=
# LISTEN_ADDR | string | default: standalone scheduler and extractor: :8080; background uses SCHEDULER_LISTEN_ADDR
# LISTEN_ADDR=
# LOCAL_CATEGORY | string | default: empty / unset
# LOCAL_CATEGORY=
# LOCAL_HTTP_SETUP | boolean | default: false
# LOCAL_HTTP_SETUP=
# LOG_LEVEL | string | default: Compose: default 'INFO'
# LOG_LEVEL=
# MAX_WORKERS | number | default: 5
# MAX_WORKERS=
# NEWS_AI_DB_MAX_CONNS | number | default: 2
# NEWS_AI_DB_MAX_CONNS=
# NEWS_AI_SOCKET | string | default: empty / unset
# NEWS_AI_SOCKET=
# NEWS_AI_TOKEN | secret string | default: empty / unset
# NEWS_AI_TOKEN=
