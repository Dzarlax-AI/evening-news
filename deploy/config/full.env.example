# SCHEDULER_HTTP_TIMEOUT_SECONDS | number | default: 5 seconds in legacy web scheduler client
# SCHEDULER_HTTP_TIMEOUT_SECONDS=
# SCHEDULER_IMAGE | string | default: Compose: required
# SCHEDULER_IMAGE=
# SCHEDULER_LISTEN_ADDR | string | default: :8080 in background
# SCHEDULER_LISTEN_ADDR=
# SCHEDULER_MAX_INFLIGHT | number | default: 4
# SCHEDULER_MAX_INFLIGHT=
# SCHEDULER_MAX_OUTBOX | number | default: 10000
# SCHEDULER_MAX_OUTBOX=
# SCHEDULER_POLL_INTERVAL | Go duration | default: 1s
# SCHEDULER_POLL_INTERVAL=
# SCHEDULER_START_PAUSED | boolean | default: false
# SCHEDULER_START_PAUSED=
