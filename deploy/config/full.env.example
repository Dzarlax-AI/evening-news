# NEWS_CONTROL_SUBNET=
# NEWS_CREDENTIAL_KEY | secret base64 key | default: none; required in managed domain manifest
# NEWS_CREDENTIAL_KEY=
# NEWS_CREDENTIAL_KEY_ID | key identifier | default: none; required in managed domain manifest
# NEWS_CREDENTIAL_KEY_ID=
# NEWS_EXTRACTOR_IMAGE | string | default: Compose: required
# NEWS_EXTRACTOR_IMAGE=
# NEWS_EXTRACTOR_TOKEN | secret string | default: Compose: required
# NEWS_EXTRACTOR_TOKEN=
# NEWS_INGESTION_NETWORK | string | default: Compose: required
# NEWS_INGESTION_NETWORK=
# NEWS_LIMIT_DAYS | number | default: 1 when limit enabled
# NEWS_LIMIT_DAYS=
# NEWS_LIMIT_ENABLED | boolean | default: false
# NEWS_LIMIT_ENABLED=
# NEWS_LIMIT_MAX_ARTICLES | string | default: 50 when limit enabled
# NEWS_LIMIT_MAX_ARTICLES=
# NEWS_LIMIT_NEWEST_DATE | string | default: empty; no upper date
# NEWS_LIMIT_NEWEST_DATE=
