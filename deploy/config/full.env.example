# TELEGRAM_TOKEN=
# TEXT_MODEL | string | default: empty; AI settings fallback to summarization model
# TEXT_MODEL=
# TRUSTED_HOSTS | comma-separated list | default: web: localhost,127.0.0.1,news.dzarlax.dev; example Compose: localhost,127.0.0.1,web
# TRUSTED_HOSTS=
