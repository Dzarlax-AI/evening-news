# SUMMARIZATION_MODEL | string | default: domain: gemini-3.5-flash-lite; legacy RPC: required
# SUMMARIZATION_MODEL=
# TELEGRAM_CHAT_ID | string | default: empty / unset
# TELEGRAM_CHAT_ID=
