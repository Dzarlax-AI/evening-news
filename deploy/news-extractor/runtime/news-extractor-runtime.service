[Unit]
Description=News native extraction runtime supervisor
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
BindsTo=docker.service
PartOf=docker.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/news-extractor-runtime/supervisor.py supervise --config /etc/news-extractor-runtime.json
ExecStopPost=/usr/bin/python3 /opt/news-extractor-runtime/supervisor.py stop-owned --config /etc/news-extractor-runtime.json
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=150s
KillMode=control-group
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target docker.service
